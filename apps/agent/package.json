{
  "name": "@hal/agent",
  "version": "0.0.0",
  "private": true,
  "description": "The Hal bot runtime. Joins Google Meet (Playwright headless), Zoom (Meeting SDK), and Microsoft Teams (Bot Framework) on a user's behalf. Captures audio, hands it to @hal/media for transcription, encrypts results via @hal/crypto, persists via @hal/db.",
  "type": "module",
  "bin": {
    "hal-agent": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "bun run src/cli.ts",
    "dev": "bun --hot run src/cli.ts",
    "worker": "bun run src/cli.ts worker",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hal/crypto": "workspace:*",
    "@hal/db": "workspace:*",
    "@hal/media": "workspace:*",
    "commander": "^13.0.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "playwright": "^1.49.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.5",
    "typescript": "^5.6.3"
  }
}
