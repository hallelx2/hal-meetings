# Hal Agent — runtime environment.
#
# Copy this to .env, fill in secrets, and run:
#   docker compose -f apps/agent/docker-compose.yml up -d --build
#
# Do NOT commit your .env. The .gitignore excludes apps/agent/.env.

# -----------------------------------------------------------------------------
# Database — Neon. Use the DIRECT (non-pooler) host on a long-lived worker;
# the pooler is for serverless functions on Vercel only.
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://neondb_owner:REPLACE@ep-late-scene-al3rnn2e.c-3.eu-central-1.aws.neon.tech/neondb?sslmode=require

# -----------------------------------------------------------------------------
# Envelope encryption.
# CRITICAL: this MUST be the same 64-hex-char master key that's in Vercel.
# Pull it with: `vercel env pull .env.production --environment=production`
# from the apps/web dir on your laptop, then copy the value here.
# -----------------------------------------------------------------------------
KMS_PROVIDER=local
HAL_LOCAL_KMS_KEY=REPLACE_WITH_THE_64_HEX_CHAR_KEY_FROM_VERCEL

# -----------------------------------------------------------------------------
# LLM — Google Gemini by default. Other choices: anthropic, ollama (local).
# -----------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza_REPLACE
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Speech-to-text. Deepgram in prod (real-time streaming, diarized).
# Local Whisper.cpp also supported via STT_PROVIDER=whisper-local + WHISPER_BINARY/WHISPER_MODEL.
# -----------------------------------------------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=REPLACE

# -----------------------------------------------------------------------------
# Email — Resend transactional API.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_REPLACE
HAL_FROM_EMAIL=hal@hal-meetings.com

# -----------------------------------------------------------------------------
# Bot identity templates. {{user}} is substituted with the user's display name.
# -----------------------------------------------------------------------------
HAL_BOT_DISPLAY_NAME=Hal · AI for {{user}}
HAL_BOT_DISCLOSURE=Hi — I'm Hal, an AI assistant joining on {{user}}'s behalf. I'm transcribing this meeting. Reply '/hal stop' in chat to remove me.

# -----------------------------------------------------------------------------
# Audio + runtime.
# -----------------------------------------------------------------------------
HAL_PULSE_SINK=halsink
HAL_AUDIO_DIR=/tmp/hal-audio
NODE_ENV=production
LOG_LEVEL=info
